rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProject(data, userId, projectId) {
      return data.keys().hasAll(['id', 'ownerId', 'name', 'description', 'accent', 'archived', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'name', 'description', 'accent', 'archived', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.id == projectId
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 80
        && data.description is string
        && data.description.size() <= 300
        && data.accent in ['indigo', 'emerald', 'amber', 'rose', 'slate']
        && data.archived is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSubtasksList(subtasks) {
      return subtasks is list
        && subtasks.size() <= 15
        && (
          subtasks.size() == 0
          || (
            subtasks[0] is map
            && subtasks[0].keys().hasAll(['id', 'title', 'done'])
            && subtasks[0].keys().hasOnly(['id', 'title', 'done'])
            && isValidId(subtasks[0].id)
            && subtasks[0].title is string
            && subtasks[0].title.size() >= 1
            && subtasks[0].title.size() <= 200
            && subtasks[0].done is bool
          )
        );
    }

    function isValidTask(data, userId, taskId) {
      return data.keys().hasAll([
        'id', 'ownerId', 'projectId', 'title', 'description',
        'status', 'priority', 'dueDate', 'assigneeId', 'subtasks',
        'order', 'createdAt', 'updatedAt'
      ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'projectId', 'title', 'description',
          'status', 'priority', 'dueDate', 'assigneeId', 'subtasks',
          'order', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == taskId
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && isValidId(data.projectId)
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 160
        && data.description is string
        && data.description.size() <= 2000
        && data.status in ['backlog', 'in_progress', 'in_review', 'completed']
        && data.priority in ['high', 'medium', 'low']
        && data.dueDate is string
        && data.dueDate.size() <= 32
        && isValidId(data.assigneeId)
        && data.assigneeId.size() <= 64
        && isValidSubtasksList(data.subtasks)
        && data.order is number
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---
    match /users/{userId}/private/{docId} {
      allow get: if isValidId(userId) && isValidId(docId) && docId == 'profile' && isOwner(userId);
      allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;
      allow create: if isValidId(userId)
        && isValidId(docId)
        && docId == 'profile'
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isValidId(docId)
        && docId == 'profile'
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'updatedAt']);
      allow delete: if false;
    }

    match /users/{userId}/projects/{projectId} {
      allow get: if isValidId(userId) && isValidId(projectId) && isOwner(userId);
      allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
      allow create: if isValidId(userId)
        && isValidId(projectId)
        && isOwner(userId)
        && isValidProject(incoming(), userId, projectId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isValidId(projectId)
        && isOwner(userId)
        && isValidProject(incoming(), userId, projectId)
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'accent', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['archived', 'updatedAt'])
        );
      allow delete: if isValidId(userId) && isValidId(projectId) && isOwner(userId);
    }

    match /users/{userId}/tasks/{taskId} {
      allow get: if isValidId(userId) && isValidId(taskId) && isOwner(userId);
      allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
      allow create: if isValidId(userId)
        && isValidId(taskId)
        && isOwner(userId)
        && isValidTask(incoming(), userId, taskId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/users/$(userId)/projects/$(incoming().projectId));
      allow update: if isValidId(userId)
        && isValidId(taskId)
        && isOwner(userId)
        && isValidTask(incoming(), userId, taskId)
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/users/$(userId)/projects/$(incoming().projectId))
        && (
          // Action: Transition workflow status / order (Kanban move or checkbox toggle)
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'order', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          // Action: Update subtasks checklist
          || incoming().diff(existing()).affectedKeys().hasOnly(['subtasks', 'updatedAt'])
          // Action: Update task details from detail drawer or quick actions
          || incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'description', 'status', 'priority', 'dueDate', 'assigneeId', 'projectId', 'subtasks', 'order', 'updatedAt'
          ])
        );
      allow delete: if isValidId(userId) && isValidId(taskId) && isOwner(userId);
    }
  }
}
